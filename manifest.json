{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Approval Helper",
  "version": "0.5.1",
  "description": "Optionally auto-approves ChatGPT conversation-level app consent prompts after the user enables the extension toggle.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "ChatGPT Approval Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
